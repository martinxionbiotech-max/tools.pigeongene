---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { ecosystem } from '../../data/entity';
import { demoCertificates } from '../../data/certificates';

const title = 'DNA 证书验证';
const description = '输入 DNA 证书编号，验证证书状态、DNA ID 与检测类型。找不到证书时明确返回“未找到”，绝不猜测。';

const pageUrl = `${ecosystem.tools}/dna-certificate-verification/`;

const demoNumbers = Object.keys(demoCertificates);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: '赛鸽 DNA 证书验证',
    url: pageUrl,
    description,
    applicationCategory: 'UtilitiesApplication',
    inLanguage: 'zh-CN',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: '首页', item: `${ecosystem.tools}/` },
      { '@type': 'ListItem', position: 2, name: 'DNA 证书验证', item: pageUrl },
    ],
  },
];
---

<BaseLayout {title} {description} canonical="/dna-certificate-verification/" jsonLd={jsonLd}>
  <Header />

  <main id="main">
    <section class="bg-gradient-to-br from-brand-900 to-brand-700 py-16 text-white">
      <div class="container-x">
        <nav class="text-sm text-brand-100">
          <a href="/" class="hover:text-white">首页</a> / <span class="text-white">DNA 证书验证</span>
        </nav>
        <h1 class="mt-4 text-4xl font-bold">DNA 证书验证</h1>
        <p class="mt-4 max-w-2xl text-lg text-brand-100">验证赛鸽 DNA 证书的真实性与状态。</p>
      </div>
    </section>

    <section class="container-x py-16">
      <div class="mx-auto max-w-2xl">
        <label for="cert-input" class="block text-sm font-semibold text-gray-900">证书编号</label>
        <div class="mt-2 flex gap-2">
          <input id="cert-input" type="text" class="tool-input" placeholder="例如：PG-DNA-2026-000001" autocomplete="off" />
          <button id="verify" class="btn-primary shrink-0">验证</button>
        </div>

        <div class="mt-3 rounded-lg bg-amber-50 p-4 text-sm text-amber-900">
          <strong>演示数据说明：</strong>本页面仅包含用于功能演示的模拟证书数据，不连接真实检测数据库。实际查询请以检测机构出具的正式报告为准。
        </div>

        <div class="mt-4">
          <p class="text-sm font-semibold text-gray-900">可验证的演示编号</p>
          <div class="mt-2 flex flex-wrap gap-2">
            {demoNumbers.map((number) => (
              <button type="button" class="demo-cert rounded-lg border border-gray-200 px-3 py-1.5 text-sm text-gray-700 transition hover:border-brand-300 hover:text-brand-700" data-cert={number}>
                {number}
              </button>
            ))}
          </div>
        </div>

        <div id="result-found" class="mt-8 hidden">
          <div class="card border-green-200">
            <div class="flex items-center gap-2">
              <span class="text-2xl">✅</span>
              <h2 id="result-title" class="text-lg font-bold text-green-700">证书有效</h2>
            </div>
            <dl class="mt-4 space-y-3 text-sm">
              <div class="flex justify-between"><dt class="text-gray-600">证书编号</dt><dd id="r-cert" class="font-mono font-semibold text-gray-900"></dd></div>
              <div class="flex justify-between"><dt class="text-gray-600">DNA ID</dt><dd id="r-dnaid" class="font-mono font-semibold text-gray-900"></dd></div>
              <div class="flex justify-between"><dt class="text-gray-600">签发日期</dt><dd id="r-date" class="font-semibold text-gray-900"></dd></div>
              <div class="flex justify-between"><dt class="text-gray-600">检测类型</dt><dd id="r-type" class="font-semibold text-gray-900"></dd></div>
              <div class="flex justify-between"><dt class="text-gray-600">验证状态</dt><dd id="r-status" class="font-semibold text-green-700"></dd></div>
            </dl>
          </div>
        </div>

        <div id="result-notfound" class="mt-8 hidden rounded-xl border border-amber-200 bg-amber-50 p-6 text-sm text-amber-900">
          <strong>证书未找到。</strong>
          <p id="notfound-msg" class="mt-2"></p>
          <p class="mt-2">请核对证书编号，或联系检测机构核实。</p>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<script>
  import { verifyCertificate } from '../../lib/genetics';

  const input = document.getElementById('cert-input');
  const resultFound = document.getElementById('result-found');
  const resultNotFound = document.getElementById('result-notfound');

  function verify() {
    const outcome = verifyCertificate(input.value);
    if (outcome.status === 'found' && outcome.certificate) {
      const cert = outcome.certificate;
      document.getElementById('result-title').textContent = `证书${cert.verificationStatus}`;
      document.getElementById('r-cert').textContent = cert.certificateNumber;
      document.getElementById('r-dnaid').textContent = cert.dnaId;
      document.getElementById('r-date').textContent = cert.issueDate;
      document.getElementById('r-type').textContent = cert.testingType;
      document.getElementById('r-status').textContent = cert.verificationStatus;
      resultFound.classList.remove('hidden');
      resultNotFound.classList.add('hidden');
    } else {
      document.getElementById('notfound-msg').textContent = outcome.message;
      resultFound.classList.add('hidden');
      resultNotFound.classList.remove('hidden');
    }
  }

  document.getElementById('verify').addEventListener('click', verify);
  input.addEventListener('keydown', (event) => {
    if (event.key === 'Enter') verify();
  });

  document.querySelectorAll('.demo-cert').forEach((button) => {
    button.addEventListener('click', () => {
      input.value = button.dataset.cert || '';
      verify();
    });
  });
</script>
