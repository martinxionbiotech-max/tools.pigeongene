---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { ecosystem } from '../data/entity';

const title = '在线工具';
const description = 'PigeonGene Tools 提供赛鸽遗传与 DNA 在线工具：基因查询、遗传计算器、育种计算器、亲缘计算器。';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'PigeonGene 在线工具',
    url: ecosystem.tools + '/',
    description,
    inLanguage: 'zh-CN',
  },
];

const tools = [
  { icon: '🔍', title: '基因查询', desc: '输入基因代码（如 LDHA），查询功能、关联与参考文献。', href: '/gene-lookup/' },
  { icon: '🧮', title: '遗传计算器', desc: '单基因位点的孟德尔遗传（Punnett 方格）计算。', href: '/genetics-calculator/' },
  { icon: '🥚', title: '育种计算器', desc: '双基因位点的自由组合遗传计算。', href: '/breeding-calculator/' },
  { icon: '👨‍👩‍👧', title: '亲缘计算器', desc: '基于 STR 标记的亲缘相容性分析。', href: '/parentage-calculator/' },
];
---

<BaseLayout {title} {description} jsonLd={jsonLd}>
  <Header />

  <main id="main">
    <section class="relative overflow-hidden bg-gradient-to-br from-brand-900 via-brand-800 to-brand-700 text-white">
      <div class="pointer-events-none absolute -right-24 -top-24 h-96 w-96 rounded-full bg-brand-500/20 blur-3xl" aria-hidden="true"></div>
      <div class="container-x relative py-20 lg:py-24">
        <p class="inline-flex items-center rounded-full bg-white/10 px-4 py-1.5 text-sm font-medium">
          PigeonGene Tools · 赛鸽遗传与 DNA 在线工具
        </p>
        <h1 class="mt-6 text-4xl font-bold leading-tight sm:text-5xl">
          在线遗传与 DNA 工具
        </h1>
        <p class="mt-5 max-w-2xl text-lg text-brand-100">
          基因查询、遗传计算、育种计算、亲缘分析，帮助鸽友与育种者更科学地理解遗传信息。
        </p>
        <p class="mt-3 max-w-2xl text-brand-100/90">
          <b>科学声明</b>：所有计算均基于孟德尔遗传定律，结果仅代表理论遗传概率，不预测实际比赛成绩。
        </p>
      </div>
    </section>

    <section class="container-x py-16">
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {tools.map((t) => (
          <a href={t.href} class="group card hover:border-brand-300">
            <div class="text-3xl">{t.icon}</div>
            <h2 class="mt-3 text-lg font-bold text-gray-900 group-hover:text-brand-700">{t.title}</h2>
            <p class="mt-2 text-sm text-gray-600">{t.desc}</p>
          </a>
        ))}
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
