---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="页面未找到" description="抱歉，您访问的页面不存在。" canonical="/404/" hreflang={false}>
  <Header locale="zh" />
  <main id="main" class="container-x flex min-h-[60vh] flex-col items-center justify-center py-20 text-center">
    <p class="text-6xl font-bold text-brand-600">404</p>
    <h1 class="mt-4 text-2xl font-bold text-gray-900">页面未找到</h1>
    <p class="mt-2 text-gray-600">抱歉，您访问的页面不存在或已被移动。</p>
    <div class="mt-8 flex gap-4">
      <a href="/" class="btn-primary">返回首页</a>
      <a href="/gene-lookup/" class="btn-outline">基因查询</a>
    </div>
  </main>
  <Footer locale="zh" />
</BaseLayout>
