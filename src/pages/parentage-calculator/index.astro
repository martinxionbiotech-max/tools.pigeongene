---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { ecosystem } from '../../data/entity';

const title = '亲缘计算器';
const description = '基于 STR 标记的亲缘相容性分析工具，输入父母与子代的 STR 基因型，判断位点是否相容。';

const pageUrl = `${ecosystem.tools}/parentage-calculator/`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: '赛鸽亲缘计算器',
    url: pageUrl,
    description,
    applicationCategory: 'EducationalApplication',
    inLanguage: 'zh-CN',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: '首页', item: `${ecosystem.tools}/` },
      { '@type': 'ListItem', position: 2, name: '亲缘计算器', item: pageUrl },
    ],
  },
];

const defaultLoci = ['Locus-1', 'Locus-2', 'Locus-3'];
const defaultLociJson = JSON.stringify(defaultLoci);
---

<BaseLayout {title} {description} canonical="/parentage-calculator/" jsonLd={jsonLd}>
  <Header />

  <main id="main">
    <section class="bg-gradient-to-br from-brand-900 to-brand-700 py-16 text-white">
      <div class="container-x">
        <nav class="text-sm text-brand-100">
          <a href="/" class="hover:text-white">首页</a> / <span class="text-white">亲缘计算器</span>
        </nav>
        <h1 class="mt-4 text-4xl font-bold">亲缘计算器</h1>
        <p class="mt-4 max-w-2xl text-lg text-brand-100">基于 STR 标记的亲缘相容性分析。</p>
      </div>
    </section>

    <section class="container-x py-16">
      <div class="mx-auto max-w-3xl">
        <div class="rounded-lg bg-blue-50 p-4 text-sm text-blue-900">
          <strong>使用说明：</strong>输入父本、母本与子代在 3 个 STR 位点上的基因型。等位基因用 <code>/</code> 分隔（如 <code>12/15</code>）。子代的每个等位基因应能从父母中找到来源。
        </div>

        <div class="mt-6 overflow-x-auto">
          <table class="w-full min-w-[560px] text-left text-sm">
            <thead class="border-b border-gray-200 bg-gray-50">
              <tr>
                <th class="px-3 py-2 font-semibold text-gray-900">位点</th>
                <th class="px-3 py-2 font-semibold text-gray-900">父本</th>
                <th class="px-3 py-2 font-semibold text-gray-900">母本</th>
                <th class="px-3 py-2 font-semibold text-gray-900">子代</th>
              </tr>
            </thead>
            <tbody id="loci-inputs" class="divide-y divide-gray-100"></tbody>
          </table>
        </div>

        <button id="calculate" class="btn-primary mt-6 w-full">分析亲缘相容性</button>

        <div id="result" class="mt-8 hidden">
          <div class="card">
            <h2 class="text-lg font-bold text-gray-900">分析结果</h2>
            <p id="overall" class="mt-3 text-gray-700"></p>
            <div id="loci-results" class="mt-4 space-y-2"></div>
          </div>
        </div>

        <div id="error" class="mt-6 hidden rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-800"></div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<script define:vars={{ defaultLoci }}>
  const loci = defaultLoci;

  // 初始化输入表格
  const tbody = document.getElementById('loci-inputs');
  loci.forEach((locus, i) => {
    const tr = document.createElement('tr');
    tr.innerHTML = `
      <td class="px-3 py-2 font-medium text-gray-900">${locus}</td>
      <td class="px-3 py-2"><input id="father-${i}" class="tool-input" placeholder="如 12/15" /></td>
      <td class="px-3 py-2"><input id="mother-${i}" class="tool-input" placeholder="如 14/16" /></td>
      <td class="px-3 py-2"><input id="offspring-${i}" class="tool-input" placeholder="如 12/14" /></td>
    `;
    tbody.appendChild(tr);
  });

  document.getElementById('calculate').addEventListener('click', () => {
    const err = document.getElementById('error');
    const result = document.getElementById('result');

    const father = {};
    const mother = {};
    const offspring = {};
    let complete = true;

    loci.forEach((locus, i) => {
      const f = document.getElementById(`father-${i}`).value.trim();
      const m = document.getElementById(`mother-${i}`).value.trim();
      const o = document.getElementById(`offspring-${i}`).value.trim();
      if (!f || !m || !o) complete = false;
      father[locus] = f;
      mother[locus] = m;
      offspring[locus] = o;
    });

    if (!complete) {
      err.textContent = '请完整填写所有位点的父母与子代基因型。';
      err.classList.remove('hidden');
      result.classList.add('hidden');
      return;
    }

    const lociResults = loci.map((locus) => {
      const off = offspring[locus].split('/');
      const fatherAlleles = father[locus].split('/');
      const motherAlleles = mother[locus].split('/');
      const allParent = [...fatherAlleles, ...motherAlleles];
      const consistent = off.every((a) => allParent.includes(a)) && off.some((a) => fatherAlleles.includes(a)) && off.some((a) => motherAlleles.includes(a));
      return { locus, consistent };
    });

    const allConsistent = lociResults.every((r) => r.consistent);
    document.getElementById('overall').textContent = allConsistent
      ? `已完成 ${loci.length} 个位点的分析，所有位点均与父母基因型相容，支持亲缘关系。`
      : '存在位点不匹配，提示亲缘关系存疑或数据有误。';

    document.getElementById('loci-results').innerHTML = lociResults.map((r) =>
      `<div class="flex items-center justify-between rounded-lg px-4 py-2 ${r.consistent ? 'bg-green-50' : 'bg-red-50'}">
        <span class="font-medium text-gray-900">${r.locus}</span>
        <span class="font-bold ${r.consistent ? 'text-green-700' : 'text-red-700'}">${r.consistent ? '相容 ✓' : '不匹配 ✗'}</span>
      </div>`
    ).join('');

    result.classList.remove('hidden');
    err.classList.add('hidden');
  });
</script>
