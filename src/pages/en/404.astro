---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<BaseLayout title="Page not found" description="Sorry, the page you requested does not exist." canonical="/en/404/" hreflang={false} locale="en">
  <Header locale="en" />
  <main id="main" class="container-x flex min-h-[60vh] flex-col items-center justify-center py-20 text-center">
    <p class="text-6xl font-bold text-brand-600">404</p>
    <h1 class="mt-4 text-2xl font-bold text-gray-900">Page not found</h1>
    <p class="mt-2 text-gray-600">Sorry, the page you requested does not exist or has been moved.</p>
    <div class="mt-8 flex gap-4">
      <a href="/en/" class="btn-primary">Back to home</a>
      <a href="/en/gene-lookup/" class="btn-outline">Gene Lookup</a>
    </div>
  </main>
  <Footer locale="en" />
</BaseLayout>
