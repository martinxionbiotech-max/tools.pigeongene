---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { geneDatabaseEn } from '../../../data/genesEn';
import { ecosystem } from '../../../data/entity';

const title = 'Gene Lookup';
const description =
  'Enter a gene code (such as LDHA) or a gene name (such as Myostatin) to look up the biological function, known associations, genetic markers and references of racing pigeon performance-related genes.';

const pageUrl = `${ecosystem.tools}/en/gene-lookup/`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Racing Pigeon Gene Lookup Tool',
    url: pageUrl,
    description,
    applicationCategory: 'EducationalApplication',
    inLanguage: 'en',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${ecosystem.tools}/en/` },
      { '@type': 'ListItem', position: 2, name: 'Gene Lookup', item: pageUrl },
    ],
  },
];

---

<BaseLayout {title} {description} canonical="/en/gene-lookup/" locale="en" jsonLd={jsonLd}>
  <Header locale="en" />

  <main id="main">
    <section class="bg-gradient-to-br from-brand-900 to-brand-700 py-16 text-white">
      <div class="container-x">
        <nav class="text-sm text-brand-100">
          <a href="/en/" class="hover:text-white">Home</a> / <span class="text-white">Gene Lookup</span>
        </nav>
        <h1 class="mt-4 text-4xl font-bold">Gene Lookup</h1>
        <p class="mt-4 max-w-2xl text-lg text-brand-100">Search racing pigeon performance-related genes by gene code, gene name or full gene name.</p>
      </div>
    </section>

    <section class="container-x py-16">
      <div class="mx-auto max-w-2xl">
        <label for="gene-input" class="block text-sm font-semibold text-gray-900">Enter a gene code or gene name</label>
        <div class="mt-2 flex gap-2">
          <input
            id="gene-input"
            type="text"
            class="tool-input"
            placeholder="For example: LDHA, Myostatin, Lactate Dehydrogenase A"
            autocomplete="off"
            list="gene-list"
          />
          <datalist id="gene-list">
            {geneDatabaseEn.map((g) => (
              <Fragment>
                <option value={g.code}>{g.name} · {g.en}</option>
                <option value={g.name}>{g.code} · {g.en}</option>
                <option value={g.en}>{g.code} · {g.name}</option>
              </Fragment>
            ))}
          </datalist>
          <button id="gene-search" class="btn-primary shrink-0">Search</button>
        </div>

        <div id="gene-result" class="mt-8 hidden">
          <div class="card">
            <div class="flex items-center justify-between">
              <h2 id="gene-code" class="text-2xl font-bold text-brand-700"></h2>
              <span id="gene-category" class="rounded-full bg-brand-50 px-3 py-1 text-xs font-semibold text-brand-700"></span>
            </div>
            <p id="gene-name" class="mt-1 font-semibold text-gray-900"></p>
            <p id="gene-en" class="mt-1 text-sm text-gray-500"></p>

            <div class="mt-5 space-y-4 text-sm">
              <div>
                <p class="font-semibold text-gray-900">Biological function</p>
                <p id="gene-function" class="mt-1 text-gray-700"></p>
              </div>
              <div>
                <p class="font-semibold text-gray-900">Known associations</p>
                <p id="gene-associations" class="mt-1 text-gray-700"></p>
              </div>
              <div>
                <p class="font-semibold text-gray-900">Evidence grade</p>
                <p class="mt-1 text-gray-700"><span id="gene-evidence" class="rounded bg-brand-50 px-2 py-0.5 text-xs font-bold text-brand-700"></span><span class="ml-2 text-xs text-gray-500">(B = racing-pigeon-specific statistical association / C = preliminary study in pigeons / D = polymorphism identification only)</span></p>
              </div>
              <div>
                <p class="font-semibold text-gray-900">Genetic marker</p>
                <p id="gene-marker" class="mt-1 text-gray-700"></p>
              </div>
              <div>
                <p class="font-semibold text-gray-900">References</p>
                <p id="gene-references" class="mt-1 text-gray-700"></p>
              </div>
              <div>
                <p class="font-semibold text-gray-900">Related genes</p>
                <p id="gene-related" class="mt-1 text-gray-700"></p>
              </div>
            </div>

            <div class="mt-5 rounded-lg bg-amber-50 p-4 text-xs text-amber-900">
              <strong>Scientific statement:</strong> gene associations are probabilistic information and do not constitute a prediction or a guarantee of race results.
            </div>
          </div>
        </div>

        <div id="gene-notfound" class="mt-8 hidden rounded-xl border border-red-200 bg-red-50 p-6 text-sm text-red-800">
          <strong>No gene found.</strong> Try a gene code (LDHA, MSTN, DRD4, CRY1, LRP8, GSR, CASK, F-KER) or a gene name (such as Myostatin).
        </div>

        <div class="mt-10">
          <h3 class="text-sm font-semibold text-gray-900">Genes you can look up</h3>
          <div class="mt-3 flex flex-wrap gap-2">
            {geneDatabaseEn.map((g) => (
              <a href={`/en/gene-lookup/?q=${g.code}`} class="rounded-lg border border-gray-200 px-3 py-1.5 text-sm text-gray-700 hover:border-brand-300 hover:text-brand-700">{g.code}</a>
            ))}
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer locale="en" />
</BaseLayout>

<script>
  import { geneDatabaseEn } from '../../../data/genesEn';
  import { searchGene } from '../../../lib/geneSearch';

  const input = document.getElementById('gene-input');
  const result = document.getElementById('gene-result');
  const notfound = document.getElementById('gene-notfound');

  function lookup(query) {
    const gene = searchGene(query, geneDatabaseEn);
    if (gene) {
      result.classList.remove('hidden');
      notfound.classList.add('hidden');
      document.getElementById('gene-code').textContent = gene.code;
      document.getElementById('gene-category').textContent = gene.category;
      document.getElementById('gene-name').textContent = gene.name;
      document.getElementById('gene-en').textContent = gene.en;
      document.getElementById('gene-function').textContent = gene.function;
      document.getElementById('gene-associations').textContent = gene.associations;
      document.getElementById('gene-evidence').textContent = gene.evidence;
      document.getElementById('gene-marker').textContent = gene.marker;
      document.getElementById('gene-references').textContent = gene.references;
      document.getElementById('gene-related').textContent = gene.related.join(', ');
    } else {
      result.classList.add('hidden');
      notfound.classList.remove('hidden');
    }
  }

  document.getElementById('gene-search').addEventListener('click', () => lookup(input.value));
  input.addEventListener('keydown', (e) => { if (e.key === 'Enter') lookup(input.value); });

  // Prefill from the URL query parameter
  const urlParams = new URLSearchParams(window.location.search);
  const q = urlParams.get('q');
  if (q) {
    input.value = q;
    lookup(q);
  }
</script>
