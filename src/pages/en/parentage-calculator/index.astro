---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { ecosystem } from '../../../data/entity';

const title = 'Parentage Calculator';
const description = 'An STR marker-based parentage compatibility tool: add or remove loci dynamically, enter the STR genotypes of the father, the mother and the offspring, and check whether each locus is compatible.';

const pageUrl = `${ecosystem.tools}/en/parentage-calculator/`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Pigeon Parentage Calculator',
    url: pageUrl,
    description,
    applicationCategory: 'EducationalApplication',
    inLanguage: 'en',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${ecosystem.tools}/en/` },
      { '@type': 'ListItem', position: 2, name: 'Parentage Calculator', item: pageUrl },
    ],
  },
];
---

<BaseLayout {title} {description} canonical="/en/parentage-calculator/" locale="en" jsonLd={jsonLd}>
  <Header locale="en" />

  <main id="main">
    <section class="bg-gradient-to-br from-brand-900 to-brand-700 py-16 text-white">
      <div class="container-x">
        <nav class="text-sm text-brand-100">
          <a href="/en/" class="hover:text-white">Home</a> / <span class="text-white">Parentage Calculator</span>
        </nav>
        <h1 class="mt-4 text-4xl font-bold">Parentage Calculator</h1>
        <p class="mt-4 max-w-2xl text-lg text-brand-100">STR marker-based parentage compatibility analysis.</p>
      </div>
    </section>

    <section class="container-x py-16">
      <div class="mx-auto max-w-3xl">
        <div class="rounded-lg border border-amber-200 bg-amber-50 p-4 text-sm text-amber-900">
          <strong>Educational and research use notice:</strong> this calculator is intended for genetics education and preliminary screening of data compatibility only; its output does not constitute a parentage testing conclusion. A formal parentage test requires a laboratory to carry out sampling, testing and report issuance.
        </div>
        <div class="mt-4 rounded-lg bg-blue-50 p-4 text-sm text-blue-900">
          <strong>How to use it:</strong> enter the genotypes of the father, the mother and the offspring at no fewer than 3 STR loci. Separate the two alleles with <code>/</code> (for example <code>12/15</code>). At every locus, each offspring allele should be traceable to one of the parents.
        </div>

        <div class="mt-6 overflow-x-auto">
          <table class="w-full min-w-[720px] text-left text-sm">
            <thead class="border-b border-gray-200 bg-gray-50">
              <tr>
                <th class="px-3 py-2 font-semibold text-gray-900">Locus</th>
                <th class="px-3 py-2 font-semibold text-gray-900">Father</th>
                <th class="px-3 py-2 font-semibold text-gray-900">Mother</th>
                <th class="px-3 py-2 font-semibold text-gray-900">Offspring</th>
                <th class="px-3 py-2 font-semibold text-gray-900">Actions</th>
              </tr>
            </thead>
            <tbody id="loci-inputs" class="divide-y divide-gray-100"></tbody>
          </table>
        </div>

        <div class="mt-4 flex flex-wrap gap-2">
          <button id="add-locus" class="btn-outline" type="button">+ Add locus</button>
        </div>

        <button id="calculate" class="btn-primary mt-6 w-full">Analyse parentage compatibility</button>

        <div id="result" class="mt-8 hidden">
          <div class="card">
            <h2 class="text-lg font-bold text-gray-900">Analysis result</h2>
            <p id="overall" class="mt-3 text-gray-700"></p>
            <p id="overall-consistency" class="mt-1 font-semibold text-gray-900"></p>
            <div id="loci-results" class="mt-4 space-y-2"></div>
            <p class="mt-4 rounded-lg bg-amber-50 p-4 text-xs text-amber-900">
              <strong>Scientific statement:</strong> this result serves preliminary screening of data compatibility only and does not replace a formal parentage testing report.
            </p>
          </div>
        </div>

        <div id="error" class="mt-6 hidden rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-800"></div>
      </div>
    </section>
  </main>

  <Footer locale="en" />
</BaseLayout>

<script>
  import { parentageCheck } from '../../../lib/genetics';

  const tbody = document.getElementById('loci-inputs');
  const result = document.getElementById('result');
  const errorBox = document.getElementById('error');

  function escapeHtml(value) {
    return value.replace(/[&<>"']/g, (char) => ({
      '&': '&amp;',
      '<': '&lt;',
      '>': '&gt;',
      '"': '&quot;',
      "'": '&#39;',
    })[char]);
  }

  function showError(message) {
    errorBox.textContent = message;
    errorBox.classList.remove('hidden');
    result.classList.add('hidden');
  }

  function clearOutput() {
    result.classList.add('hidden');
    errorBox.classList.add('hidden');
  }

  function appendRow(locusName = '') {
    const rowCount = tbody.querySelectorAll('tr').length;
    const autoName = locusName || `Locus-${rowCount + 1}`;
    const tr = document.createElement('tr');
    tr.innerHTML = `
      <td class="px-3 py-2">
        <input class="tool-input locus-name" value="${escapeHtml(autoName)}" placeholder="Locus-${rowCount + 1}" aria-label="Locus name" autocomplete="off" />
      </td>
      <td class="px-3 py-2">
        <input class="tool-input father-alleles" placeholder="e.g. 12/15" aria-label="Father alleles" autocomplete="off" />
      </td>
      <td class="px-3 py-2">
        <input class="tool-input mother-alleles" placeholder="e.g. 14/16" aria-label="Mother alleles" autocomplete="off" />
      </td>
      <td class="px-3 py-2">
        <input class="tool-input offspring-alleles" placeholder="e.g. 12/14" aria-label="Offspring alleles" autocomplete="off" />
      </td>
      <td class="px-3 py-2">
        <button type="button" class="remove-locus rounded-lg px-2 py-1 text-sm font-semibold text-red-600 transition hover:bg-red-50">Remove</button>
      </td>
    `;
    tbody.appendChild(tr);
  }

  function normalizeLocusNames() {
    const rows = [...tbody.querySelectorAll('tr')];
    rows.forEach((row, index) => {
      const input = row.querySelector('.locus-name');
      const value = input.value.trim();
      if (!value || /^Locus-\d+$/.test(value)) {
        input.value = `Locus-${index + 1}`;
      }
      input.placeholder = `Locus-${index + 1}`;
    });
  }

  for (let i = 1; i <= 3; i += 1) {
    appendRow(`Locus-${i}`);
  }
  normalizeLocusNames();

  function collectRecords() {
    const rows = [...tbody.querySelectorAll('tr')];
    if (rows.length < 3) {
      throw new Error('At least 3 STR loci are needed to run a parentage compatibility analysis.');
    }

    const father = {};
    const mother = {};
    const offspring = {};
    const usedNames = new Set();

    rows.forEach((row, index) => {
      const rawName = row.querySelector('.locus-name').value.trim();
      const locus = rawName || `Locus-${index + 1}`;
      if (usedNames.has(locus)) {
        throw new Error(`Locus names must be unique: "${locus}". Please give each locus a distinct name.`);
      }
      usedNames.add(locus);

      father[locus] = row.querySelector('.father-alleles').value.trim();
      mother[locus] = row.querySelector('.mother-alleles').value.trim();
      offspring[locus] = row.querySelector('.offspring-alleles').value.trim();
    });

    return { father, mother, offspring };
  }

  function calculate() {
    try {
      const { father, mother, offspring } = collectRecords();
      const outcome = parentageCheck(father, mother, offspring, 'en');

      if (outcome.status === 'insufficient') {
        showError(outcome.message);
        return;
      }

      document.getElementById('overall').textContent = outcome.message;
      document.getElementById('overall-consistency').textContent = outcome.overallConsistency;

      document.getElementById('loci-results').innerHTML = outcome.loci.map((locus) => {
        const tone = locus.consistent
          ? 'border-green-200 bg-green-50'
          : 'border-red-200 bg-red-50';
        const labelTone = locus.consistent ? 'text-green-700' : 'text-red-700';
        const label = locus.consistent ? 'Compatible ✓' : 'Not a match ✗';
        return `
          <div class="rounded-lg border px-4 py-2 ${tone}">
            <div class="flex items-center justify-between gap-3">
              <span class="font-semibold text-gray-900">${escapeHtml(locus.locus)}</span>
              <span class="font-bold ${labelTone}">${label}</span>
            </div>
            <p class="mt-1 text-xs text-gray-600">Father ${escapeHtml(locus.fatherAlleles.join('/'))} · Mother ${escapeHtml(locus.motherAlleles.join('/'))} · Offspring ${escapeHtml(locus.offspringAlleles.join('/'))}</p>
          </div>
        `;
      }).join('');

      result.classList.remove('hidden');
      errorBox.classList.add('hidden');
    } catch (error) {
      showError(error instanceof Error ? error.message : 'The input is invalid. Please check it and try again.');
    }
  }

  document.getElementById('add-locus').addEventListener('click', () => {
    appendRow();
    normalizeLocusNames();
    clearOutput();
  });

  tbody.addEventListener('click', (event) => {
    const button = event.target.closest('.remove-locus');
    if (!button) return;
    const row = button.closest('tr');
    if (row) row.remove();
    normalizeLocusNames();
    clearOutput();
  });

  document.getElementById('calculate').addEventListener('click', calculate);
</script>
