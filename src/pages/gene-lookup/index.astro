---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { geneDatabase } from '../../data/genes';
import { ecosystem } from '../../data/entity';

const title = '基因查询';
const description = '输入基因代码（如 LDHA、MSTN），查询赛鸽性能相关基因的功能、已知关联、遗传标记与参考文献。';

const pageUrl = `${ecosystem.tools}/gene-lookup/`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: '赛鸽基因查询工具',
    url: pageUrl,
    description,
    applicationCategory: 'EducationalApplication',
    inLanguage: 'zh-CN',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: '首页', item: `${ecosystem.tools}/` },
      { '@type': 'ListItem', position: 2, name: '基因查询', item: pageUrl },
    ],
  },
];

// 将基因数据转为 JSON 供客户端查询
const geneJson = JSON.stringify(geneDatabase);
---

<BaseLayout {title} {description} canonical="/gene-lookup/" jsonLd={jsonLd}>
  <Header />

  <main id="main">
    <section class="bg-gradient-to-br from-brand-900 to-brand-700 py-16 text-white">
      <div class="container-x">
        <nav class="text-sm text-brand-100">
          <a href="/" class="hover:text-white">首页</a> / <span class="text-white">基因查询</span>
        </nav>
        <h1 class="mt-4 text-4xl font-bold">基因查询</h1>
        <p class="mt-4 max-w-2xl text-lg text-brand-100">输入基因代码查询赛鸽性能相关基因。</p>
      </div>
    </section>

    <section class="container-x py-16">
      <div class="mx-auto max-w-2xl">
        <label for="gene-input" class="block text-sm font-semibold text-gray-900">输入基因代码</label>
        <div class="mt-2 flex gap-2">
          <input
            id="gene-input"
            type="text"
            class="tool-input uppercase"
            placeholder="例如：LDHA、MSTN、DRD4"
            autocomplete="off"
            list="gene-list"
          />
          <datalist id="gene-list">
            {geneDatabase.map((g) => <option value={g.code}>{g.name}</option>)}
          </datalist>
          <button id="gene-search" class="btn-primary shrink-0">查询</button>
        </div>

        <div id="gene-result" class="mt-8 hidden">
          <div class="card">
            <div class="flex items-center justify-between">
              <h2 id="gene-code" class="text-2xl font-bold text-brand-700"></h2>
              <span id="gene-category" class="rounded-full bg-brand-50 px-3 py-1 text-xs font-semibold text-brand-700"></span>
            </div>
            <p id="gene-name" class="mt-1 font-semibold text-gray-900"></p>
            <p id="gene-en" class="mt-1 text-sm text-gray-500"></p>

            <div class="mt-5 space-y-4 text-sm">
              <div>
                <p class="font-semibold text-gray-900">生物学功能</p>
                <p id="gene-function" class="mt-1 text-gray-700"></p>
              </div>
              <div>
                <p class="font-semibold text-gray-900">已知关联</p>
                <p id="gene-associations" class="mt-1 text-gray-700"></p>
              </div>
              <div>
                <p class="font-semibold text-gray-900">遗传标记</p>
                <p id="gene-marker" class="mt-1 text-gray-700"></p>
              </div>
              <div>
                <p class="font-semibold text-gray-900">参考文献</p>
                <p id="gene-references" class="mt-1 text-gray-700"></p>
              </div>
              <div>
                <p class="font-semibold text-gray-900">相关基因</p>
                <p id="gene-related" class="mt-1 text-gray-700"></p>
              </div>
            </div>

            <div class="mt-5 rounded-lg bg-amber-50 p-4 text-xs text-amber-900">
              <strong>科学声明：</strong>基因关联为概率性信息，不构成对比赛成绩的预测或保证。
            </div>
          </div>
        </div>

        <div id="gene-notfound" class="mt-8 hidden rounded-xl border border-red-200 bg-red-50 p-6 text-sm text-red-800">
          <strong>未找到该基因。</strong>请检查代码是否正确（如 LDHA、MSTN、DRD4、CRY1、LRP8、GSR、CASK、F-KER）。
        </div>

        <div class="mt-10">
          <h3 class="text-sm font-semibold text-gray-900">可查询的基因</h3>
          <div class="mt-3 flex flex-wrap gap-2">
            {geneDatabase.map((g) => (
              <a href={`/gene-lookup/?q=${g.code}`} class="rounded-lg border border-gray-200 px-3 py-1.5 text-sm text-gray-700 hover:border-brand-300 hover:text-brand-700">{g.code}</a>
            ))}
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<script define:vars={{ geneDatabase }}>
  const geneData = geneDatabase;
  const input = document.getElementById('gene-input');
  const result = document.getElementById('gene-result');
  const notfound = document.getElementById('gene-notfound');

  function lookup(query) {
    const q = query.trim().toUpperCase();
    const gene = geneData.find((g) => g.code === q || g.en.toUpperCase() === q);
    if (gene) {
      result.classList.remove('hidden');
      notfound.classList.add('hidden');
      document.getElementById('gene-code').textContent = gene.code;
      document.getElementById('gene-category').textContent = gene.category;
      document.getElementById('gene-name').textContent = gene.name;
      document.getElementById('gene-en').textContent = gene.en;
      document.getElementById('gene-function').textContent = gene.function;
      document.getElementById('gene-associations').textContent = gene.associations;
      document.getElementById('gene-marker').textContent = gene.marker;
      document.getElementById('gene-references').textContent = gene.references;
      document.getElementById('gene-related').textContent = gene.related.join('、');
    } else {
      result.classList.add('hidden');
      notfound.classList.remove('hidden');
    }
  }

  document.getElementById('gene-search').addEventListener('click', () => lookup(input.value));
  input.addEventListener('keydown', (e) => { if (e.key === 'Enter') lookup(input.value); });

  // URL 参数预填
  const urlParams = new URLSearchParams(window.location.search);
  const q = urlParams.get('q');
  if (q) {
    input.value = q;
    lookup(q);
  }
</script>
