---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { ecosystem } from '../../data/entity';

const title = '遗传计算器';
const description = '单基因位点的孟德尔遗传（Punnett 方格）计算器，输入亲本基因型，计算子代基因型与表型的理论概率。';

const pageUrl = `${ecosystem.tools}/genetics-calculator/`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: '赛鸽遗传计算器',
    url: pageUrl,
    description,
    applicationCategory: 'EducationalApplication',
    inLanguage: 'zh-CN',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: '首页', item: `${ecosystem.tools}/` },
      { '@type': 'ListItem', position: 2, name: '遗传计算器', item: pageUrl },
    ],
  },
];
---

<BaseLayout {title} {description} canonical="/genetics-calculator/" jsonLd={jsonLd}>
  <Header />

  <main id="main">
    <section class="bg-gradient-to-br from-brand-900 to-brand-700 py-16 text-white">
      <div class="container-x">
        <nav class="text-sm text-brand-100">
          <a href="/" class="hover:text-white">首页</a> / <span class="text-white">遗传计算器</span>
        </nav>
        <h1 class="mt-4 text-4xl font-bold">遗传计算器</h1>
        <p class="mt-4 max-w-2xl text-lg text-brand-100">单基因位点的孟德尔遗传（Punnett 方格）计算。</p>
      </div>
    </section>

    <section class="container-x py-16">
      <div class="mx-auto max-w-2xl">
        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <label for="parent-a" class="block text-sm font-semibold text-gray-900">亲本 A 基因型</label>
            <select id="parent-a" class="tool-input mt-2">
              <option value="AA">AA（纯合显性）</option>
              <option value="Aa" selected>Aa（杂合）</option>
              <option value="aa">aa（纯合隐性）</option>
            </select>
          </div>
          <div>
            <label for="parent-b" class="block text-sm font-semibold text-gray-900">亲本 B 基因型</label>
            <select id="parent-b" class="tool-input mt-2">
              <option value="AA">AA（纯合显性）</option>
              <option value="Aa" selected>Aa（杂合）</option>
              <option value="aa">aa（纯合隐性）</option>
            </select>
          </div>
        </div>

        <button id="calculate" class="btn-primary mt-6 w-full">计算</button>

        <div id="result" class="mt-8 hidden">
          <div class="card">
            <h2 class="text-lg font-bold text-gray-900">子代基因型概率</h2>
            <div id="genotype-results" class="mt-4 space-y-2"></div>
          </div>
          <div class="card mt-4">
            <h2 class="text-lg font-bold text-gray-900">子代表型概率</h2>
            <p class="mt-1 text-xs text-gray-500">假设 A 为显性等位基因</p>
            <div id="phenotype-results" class="mt-4 space-y-2"></div>
          </div>
          <div class="mt-4 rounded-lg bg-amber-50 p-4 text-xs text-amber-900">
            <strong>科学声明：</strong>以上为理论遗传概率，仅代表遗传倾向的统计分布，不预测实际比赛成绩。
          </div>
        </div>

        <div id="error" class="mt-6 hidden rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-800"></div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<script>
  function punnett(parentA, parentB) {
    const a = parentA.split('');
    const b = parentB.split('');
    const combos = [];
    for (const allele1 of a) {
      for (const allele2 of b) {
        combos.push([allele1, allele2].sort().join(''));
      }
    }
    const counts = {};
    for (const c of combos) counts[c] = (counts[c] || 0) + 1;
    const order = ['AA', 'Aa', 'aa'];
    const offspring = order.filter((g) => counts[g]).map((g) => ({ genotype: g, pct: ((counts[g] / 4) * 100).toFixed(0) + '%' }));
    const dom = (counts['AA'] || 0) + (counts['Aa'] || 0);
    const rec = counts['aa'] || 0;
    const phenotypes = [
      { label: '显性表型（AA 或 Aa）', pct: ((dom / 4) * 100).toFixed(0) + '%' },
      { label: '隐性表型（aa）', pct: ((rec / 4) * 100).toFixed(0) + '%' },
    ];
    return { offspring, phenotypes };
  }

  document.getElementById('calculate').addEventListener('click', () => {
    const a = document.getElementById('parent-a').value;
    const b = document.getElementById('parent-b').value;
    const { offspring, phenotypes } = punnett(a, b);

    const genDiv = document.getElementById('genotype-results');
    genDiv.innerHTML = offspring.map((o) =>
      `<div class="flex items-center justify-between rounded-lg bg-gray-50 px-4 py-2"><span class="font-mono font-semibold text-gray-900">${o.genotype}</span><span class="font-bold text-brand-700">${o.pct}</span></div>`
    ).join('');

    const phenDiv = document.getElementById('phenotype-results');
    phenDiv.innerHTML = phenotypes.map((p) =>
      `<div class="flex items-center justify-between rounded-lg bg-gray-50 px-4 py-2"><span class="text-gray-700">${p.label}</span><span class="font-bold text-brand-700">${p.pct}</span></div>`
    ).join('');

    document.getElementById('result').classList.remove('hidden');
    document.getElementById('error').classList.add('hidden');
  });

  // 初始计算
  document.getElementById('calculate').click();
</script>
