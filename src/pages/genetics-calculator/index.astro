---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { ecosystem } from '../../data/entity';

const title = '遗传计算器';
const description = '单基因位点的孟德尔遗传（Punnett 方格）计算器，输入亲本基因型，计算子代基因型与表型的理论概率。';

const pageUrl = `${ecosystem.tools}/genetics-calculator/`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: '赛鸽遗传计算器',
    url: pageUrl,
    description,
    applicationCategory: 'EducationalApplication',
    inLanguage: 'zh-CN',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: '首页', item: `${ecosystem.tools}/` },
      { '@type': 'ListItem', position: 2, name: '遗传计算器', item: pageUrl },
    ],
  },
];
---

<BaseLayout {title} {description} canonical="/genetics-calculator/" jsonLd={jsonLd}>
  <Header />

  <main id="main">
    <section class="bg-gradient-to-br from-brand-900 to-brand-700 py-16 text-white">
      <div class="container-x">
        <nav class="text-sm text-brand-100">
          <a href="/" class="hover:text-white">首页</a> / <span class="text-white">遗传计算器</span>
        </nav>
        <h1 class="mt-4 text-4xl font-bold">遗传计算器</h1>
        <p class="mt-4 max-w-2xl text-lg text-brand-100">单基因位点的孟德尔遗传（Punnett 方格）计算。</p>
      </div>
    </section>

    <section class="container-x py-16">
      <div class="mx-auto max-w-2xl">
        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <label for="parent-a" class="block text-sm font-semibold text-gray-900">亲本 A 基因型</label>
            <input id="parent-a" type="text" class="tool-input mt-2" value="Aa" placeholder="例如 AA、Aa、aa" autocomplete="off" maxlength="2" />
          </div>
          <div>
            <label for="parent-b" class="block text-sm font-semibold text-gray-900">亲本 B 基因型</label>
            <input id="parent-b" type="text" class="tool-input mt-2" value="Aa" placeholder="例如 AA、Aa、aa" autocomplete="off" maxlength="2" />
          </div>
        </div>

        <div class="mt-4">
          <label for="dominant-allele" class="block text-sm font-semibold text-gray-900">显性等位基因</label>
          <input id="dominant-allele" type="text" class="tool-input mt-2" value="A" placeholder="例如 A、B、R" autocomplete="off" maxlength="1" />
          <p class="mt-2 text-xs text-gray-500">可自由指定显性等位基因；大小写会被视为不同等位基因。</p>
        </div>

        <button id="calculate" class="btn-primary mt-6 w-full">计算</button>

        <div id="result" class="mt-8 hidden">
          <div class="card">
            <h2 class="text-lg font-bold text-gray-900">子代基因型概率</h2>
            <div id="genotype-results" class="mt-4 space-y-2"></div>
          </div>
          <div class="card mt-4">
            <h2 class="text-lg font-bold text-gray-900">子代表型概率</h2>
            <p id="phenotype-note" class="mt-1 text-xs text-gray-500">假设 A 为显性等位基因</p>
            <div id="phenotype-results" class="mt-4 space-y-2"></div>
          </div>
          <div class="mt-4 rounded-lg bg-amber-50 p-4 text-xs text-amber-900">
            <strong>科学声明：</strong>以上为理论遗传概率，仅代表遗传倾向的统计分布，不预测实际比赛成绩。
          </div>
        </div>

        <div id="error" class="mt-6 hidden rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-800"></div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<script>
  import { punnettSquare } from '../../lib/genetics';

  const parentA = document.getElementById('parent-a');
  const parentB = document.getElementById('parent-b');
  const dominantAllele = document.getElementById('dominant-allele');
  const result = document.getElementById('result');
  const errorBox = document.getElementById('error');

  function calculate() {
    try {
      const outcome = punnettSquare(parentA.value, parentB.value, {
        dominantAllele: dominantAllele.value,
      });

      document.getElementById('phenotype-note').textContent = `假设 ${outcome.dominantAllele} 为显性等位基因`;

      document.getElementById('genotype-results').innerHTML = outcome.offspring.map((item) =>
        `<div class="flex items-center justify-between rounded-lg bg-gray-50 px-4 py-2"><span class="font-mono font-semibold text-gray-900">${item.genotype}</span><span class="font-bold text-brand-700">${item.percentage}</span></div>`
      ).join('');

      document.getElementById('phenotype-results').innerHTML = outcome.phenotypes.map((item) =>
        `<div class="flex items-start justify-between gap-3 rounded-lg bg-gray-50 px-4 py-2">
          <div>
            <p class="text-gray-800">${item.phenotype}</p>
            <p class="mt-0.5 text-xs text-gray-500">基因型：${item.genotypes.length ? item.genotypes.join('、') : '无'}</p>
          </div>
          <span class="font-bold text-brand-700">${item.percentage}</span>
        </div>`
      ).join('');

      result.classList.remove('hidden');
      errorBox.classList.add('hidden');
    } catch (error) {
      errorBox.textContent = error instanceof Error ? error.message : '输入有误，请检查后重试。';
      errorBox.classList.remove('hidden');
      result.classList.add('hidden');
    }
  }

  document.getElementById('calculate').addEventListener('click', calculate);
  [parentA, parentB, dominantAllele].forEach((input) => {
    input.addEventListener('keydown', (event) => {
      if (event.key === 'Enter') calculate();
    });
  });

  calculate();
</script>
