---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { ecosystem } from '../../data/entity';

const title = '育种计算器';
const description = '双基因位点的自由组合遗传计算器，输入两个亲本的基因型（如 AaBb），计算子代基因型的理论概率分布。';

const pageUrl = `${ecosystem.tools}/breeding-calculator/`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: '赛鸽育种计算器',
    url: pageUrl,
    description,
    applicationCategory: 'EducationalApplication',
    inLanguage: 'zh-CN',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: '首页', item: `${ecosystem.tools}/` },
      { '@type': 'ListItem', position: 2, name: '育种计算器', item: pageUrl },
    ],
  },
];
---

<BaseLayout {title} {description} canonical="/breeding-calculator/" jsonLd={jsonLd}>
  <Header />

  <main id="main">
    <section class="bg-gradient-to-br from-brand-900 to-brand-700 py-16 text-white">
      <div class="container-x">
        <nav class="text-sm text-brand-100">
          <a href="/" class="hover:text-white">首页</a> / <span class="text-white">育种计算器</span>
        </nav>
        <h1 class="mt-4 text-4xl font-bold">育种计算器</h1>
        <p class="mt-4 max-w-2xl text-lg text-brand-100">双基因位点的自由组合遗传计算。</p>
      </div>
    </section>

    <section class="container-x py-16">
      <div class="mx-auto max-w-2xl">
        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <label for="parent-a" class="block text-sm font-semibold text-gray-900">亲本 A 基因型</label>
            <input id="parent-a" type="text" class="tool-input mt-2" value="AaBb" placeholder="如 AaBb" maxlength="4" autocomplete="off" />
          </div>
          <div>
            <label for="parent-b" class="block text-sm font-semibold text-gray-900">亲本 B 基因型</label>
            <input id="parent-b" type="text" class="tool-input mt-2" value="AaBb" placeholder="如 AaBb" maxlength="4" autocomplete="off" />
          </div>
        </div>
        <p class="mt-2 text-xs text-gray-500">格式：4 个英文字母，两个基因位点各两个等位基因（如 AaBb）。支持大小写混写，AaBb 与 aabb 会按原字母含义计算。</p>

        <button id="calculate" class="btn-primary mt-4 w-full">计算</button>

        <div id="result" class="mt-8 hidden">
          <div class="card">
            <h2 class="text-lg font-bold text-gray-900">子代基因型概率</h2>
            <div id="results" class="mt-4 grid gap-2 sm:grid-cols-2"></div>
          </div>
          <div class="mt-4 rounded-lg bg-amber-50 p-4 text-xs text-amber-900">
            <strong>科学声明：</strong>以上为理论遗传概率，不预测实际比赛成绩。
          </div>
        </div>

        <div id="error" class="mt-6 hidden rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-800"></div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<script>
  import { dihybridCross } from '../../lib/genetics';

  const parentA = document.getElementById('parent-a');
  const parentB = document.getElementById('parent-b');
  const result = document.getElementById('result');
  const errorBox = document.getElementById('error');

  function calculate() {
    try {
      const outcome = dihybridCross(parentA.value, parentB.value);

      document.getElementById('results').innerHTML = outcome.offspring.map((item) =>
        `<div class="flex items-center justify-between rounded-lg bg-gray-50 px-3 py-2">
          <span class="font-mono font-semibold text-gray-900">${item.genotype}</span>
          <span class="font-bold text-brand-700">${item.percentage}</span>
        </div>`
      ).join('');

      result.classList.remove('hidden');
      errorBox.classList.add('hidden');
    } catch (error) {
      errorBox.textContent = error instanceof Error ? error.message : '输入有误，请检查后重试。';
      errorBox.classList.remove('hidden');
      result.classList.add('hidden');
    }
  }

  document.getElementById('calculate').addEventListener('click', calculate);
  [parentA, parentB].forEach((input) => {
    input.addEventListener('keydown', (event) => {
      if (event.key === 'Enter') calculate();
    });
  });

  calculate();
</script>
