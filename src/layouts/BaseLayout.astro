---
import '../styles/global.css';
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-500.css';
import '@fontsource/inter/latin-600.css';
import '@fontsource/inter/latin-700.css';
import { org, ecosystem, sameAs, services } from '../data/entity';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  jsonLd?: Record<string, any>[];
  type?: string;
  ogImage?: string;
}

const {
  title,
  description,
  canonical,
  jsonLd = [],
  type = 'website',
  ogImage = '/og-default.png',
} = Astro.props;

const siteUrl = ecosystem.tools;
const fullTitle = title.includes('PigeonGene Tools') ? title : `${title} | PigeonGene Tools`;

const baseJsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': `${siteUrl}/#organization`,
    name: org.name,
    alternateName: org.alternateName,
    legalName: org.legalName,
    url: org.url,
    logo: org.logo,
    description: org.description,
    foundingDate: org.foundingDate,
    numberOfEmployees: org.numberOfEmployees,
    award: org.award,
    hasCredential: { '@type': 'EducationalOccupationalCredential', name: org.hasCredential },
    knowsAbout: org.knowsAbout,
    areaServed: org.areaServed,
    address: { '@type': 'PostalAddress', ...org.address },
    contactPoint: {
      '@type': 'ContactPoint',
      email: org.email,
      telephone: org.telephone,
      contactType: 'customer service',
    },
    sameAs,
    makesOffer: services.map((s) => ({ '@id': `${siteUrl}/#${s.slug}` })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${siteUrl}/#website`,
    url: siteUrl + '/',
    name: 'PigeonGene Tools — 赛鸽遗传与 DNA 在线工具',
    description,
    publisher: { '@id': `${siteUrl}/#organization` },
    inLanguage: 'zh-CN',
  },
  ...services.map((s) => ({
    '@context': 'https://schema.org',
    '@type': 'Service',
    '@id': `${siteUrl}/#${s.slug}`,
    name: s.name,
    serviceType: s.serviceType,
    description: s.description,
    provider: { '@id': `${siteUrl}/#organization` },
    areaServed: 'Worldwide',
    url: 'https://senopigeon.com/',
    category: 'Genetic Testing',
    inLanguage: 'zh-CN',
  })),
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical ? new URL(canonical, siteUrl).href : siteUrl + '/'} />
    <link rel="icon" type="image/png" href="/favicon.png" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="PigeonGene Tools" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical ? new URL(canonical, siteUrl).href : siteUrl + '/'} />
    <meta property="og:image" content={new URL(ogImage, siteUrl).href} />
    <meta property="og:locale" content="zh_CN" />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify([...baseJsonLd, ...jsonLd])} />
  </head>
  <body class="min-h-screen bg-white">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-white focus:px-4 focus:py-2 focus:shadow-lg">跳到主要内容</a>
    <slot />
  </body>
</html>
