---
import { org, ecosystem } from '../data/entity';

const knowledgeNav = [
  { label: '基因查询', href: '/gene-lookup/' },
  { label: '育种计算器', href: '/breeding-calculator/' },
  { label: '亲缘计算器', href: '/parentage-calculator/' },
  { label: '术语表', href: '/glossary/' },
];

const sisterSites = [
  { label: '主站（检测服务）', href: ecosystem.main },
  { label: '遗传知识库', href: ecosystem.genetics },
  { label: '健康知识库', href: ecosystem.health },
  { label: '科研中心', href: ecosystem.research },
];
---

<footer class="border-t border-gray-200 bg-gray-50">
  <div class="container-x grid gap-10 py-14 md:grid-cols-2 lg:grid-cols-4">
    <div>
      <div class="flex items-center gap-2">
        <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-brand-600 text-lg text-white">🛠️</span>
        <span class="font-bold text-gray-900">PigeonGene <span class="text-brand-700">Tools</span></span>
      </div>
      <p class="mt-3 text-sm leading-relaxed text-gray-600">
        赛鸽在线工具，由 {org.name} 提供技术支持。
      </p>
    </div>

    <div>
      <h2 class="text-sm font-semibold text-gray-900">知识栏目</h2>
      <ul class="mt-4 space-y-2 text-sm text-gray-600">
        {knowledgeNav.map((n) => (
          <li><a href={n.href} class="hover:text-brand-600">{n.label}</a></li>
        ))}
      </ul>
    </div>

    <div>
      <h2 class="text-sm font-semibold text-gray-900">PigeonGene 生态</h2>
      <ul class="mt-4 space-y-2 text-sm text-gray-600">
        {sisterSites.map((s) => (
          <li><a href={s.href} class="hover:text-brand-600" rel="noopener">{s.label}</a></li>
        ))}
      </ul>
    </div>

    <div>
      <h2 class="text-sm font-semibold text-gray-900">帮助与联系</h2>
      <ul class="mt-4 space-y-2 text-sm text-gray-600">
        <li><a href={`${ecosystem.main}/faq/`} class="hover:text-brand-600" rel="noopener">常见问题</a></li>
        <li><a href="/glossary/" class="hover:text-brand-600">术语表</a></li>
        <li><span aria-hidden="true">📧</span> <a href={`mailto:${org.email}`} class="hover:text-brand-600">{org.email}</a></li>
        <li><span aria-hidden="true">📞</span> <a href="tel:+8615612372623" class="hover:text-brand-600">+86 15612372623</a></li>
      </ul>
    </div>
  </div>

  <div class="border-t border-gray-200">
    <div class="container-x flex flex-col items-center justify-between gap-3 py-6 text-xs text-gray-500 sm:flex-row">
      <p>© 2026 {org.name} · 保留所有权利</p>
      <p class="flex flex-wrap gap-3">
        <a href={ecosystem.main} class="hover:text-brand-600" rel="noopener">senopigeon.com</a>
        <span aria-hidden="true">·</span>
        <a href="/llms.txt" class="hover:text-brand-600">llms.txt</a>
        <span aria-hidden="true">·</span>
        <a href="/sitemap-index.xml" class="hover:text-brand-600">sitemap</a>
      </p>
    </div>
  </div>
</footer>
